# =============================
# Email config

# For local development without sending real email:
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-brevo-smtp-login@smtp-brevo.com
EMAIL_HOST_PASSWORD=your-brevo-smtp-key
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Your School <no-reply@yourdomain.com>
EMAIL_FROM_ADDRESS=Your School <no-reply@yourdomain.com>

# Absolute base URL used in outgoing email links (login buttons, etc.)
# Local development: http://localhost:8000
# Production: https://ssm.imperialacademy.edu.gh (use https if SSL is enabled)
SITE_URL=http://localhost:8000

# =============================
# Other

DEBUG=True
SECRET_KEY="<your_secret_key>"

# Comma-separated list of domains allowed by Django
# ALLOWED_HOSTS="127.0.0.1,localhost,127.0.0.1:8000,.localhost,ssm.imperialacademy.edu.gh,.imperialacademy.edu.gh"

# Comma-separated list of master domains that route to the Super Admin Portal
# MASTER_DOMAINS="admin.localhost,master.localhost,127.0.0.1,ssm.imperialacademy.edu.gh"

# =============================
# Database Configuration
# Set USE_POSTGRESQL=True on production server, False/omit for SQLite dev
USE_POSTGRESQL=False
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432